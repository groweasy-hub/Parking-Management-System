# MongoDB (Atlas recommended in production — must be a replica set to support
# transactions and change streams; Atlas clusters satisfy this by default)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/parking_system?retryWrites=true&w=majority

# Local dev alternative (must be a single-node replica set, see README)
# MONGODB_URI=mongodb://127.0.0.1:27017/parking_system?replicaSet=rs0

PORT=4000
NODE_ENV=development

# Auth
JWT_ACCESS_SECRET=change-this-access-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_DOMAIN=localhost

# Frontend origin(s) allowed to call this API / receive cookies
CORS_ORIGIN=http://localhost:3000

# Cloudinary (company logo storage). If unset, falls back to local disk
# storage under backend/uploads (dev only — not suitable for serverless
# production hosting).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Bootstrap super admin (created by `npm run seed` if it doesn't exist)
SEED_SUPER_ADMIN_EMAIL=admin@parking.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
